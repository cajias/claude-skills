{
  "$schema": "./config.schema.json",
  "max_iterations": 5,
  "score_threshold": 85,
  "mode": "improve",
  "preserve_custom": true,
  "sections_to_generate": [
    "highlights",
    "installation",
    "usage",
    "api",
    "configuration",
    "contributing",
    "license"
  ],
  "preserve_sections": [],
  "require_sections": ["highlights", "installation", "usage"],
  "require_code_examples": true,
  "require_installation": true,
  "min_section_length": 50,
  "check_links": true,
  "strict_mode": false,
  "evaluation_weights": {
    "essential_sections": 0.4,
    "content_quality": 0.3,
    "examples": 0.2,
    "formatting": 0.1
  },
  "priority_thresholds": {
    "critical_block": true,
    "high_priority_max": 2
  }
}
