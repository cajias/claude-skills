{
  "name": "claude-skills",
  "version": "1.1.0",
  "description": "Collection of Claude Code skills",
  "private": true,
  "scripts": {
    "lint": "npm run lint:md && ls-lint",
    "lint:md": "npx markdownlint '**/*.md' --ignore node_modules",
    "lint:fix": "npm run lint:md:fix",
    "lint:md:fix": "npx markdownlint '**/*.md' --ignore node_modules --fix",
    "format": "npx prettier --write '**/*.{md,json,yml,yaml}' --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "npx prettier --check '**/*.{md,json,yml,yaml}' --ignore-path .gitignore --ignore-path .prettierignore",
    "validate": "bash scripts/validate.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@lint-configs/markdownlint-config": "https://github.com/cajias/lint-configs/releases/download/v1.0.5/lint-configs-markdownlint-config-1.0.0.tgz",
    "@ls-lint/ls-lint": "^2.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "markdownlint-cli": "^0.43.0",
    "prettier": "^3.7.1"
  },
  "lint-staged": {
    "*.{json,yml,yaml}": [
      "npx prettier --write"
    ],
    "*.md": [
      "npx markdownlint --fix",
      "npx prettier --write"
    ],
    "plugins/ai-zettelkasten/**/*.py": [
      "bash -c 'cd plugins/ai-zettelkasten && uvx ruff format -- \"$@\"' --",
      "bash -c 'cd plugins/ai-zettelkasten && uvx ruff check --fix -- \"$@\"' --",
      "bash -c 'cd plugins/ai-zettelkasten && uvx ruff check -- \"$@\"' --"
    ],
    "plugins/semantic-search/**/*.py": [
      "bash -c 'cd plugins/semantic-search && uv run ruff format -- \"$@\"' --",
      "bash -c 'cd plugins/semantic-search && uv run ruff check --fix -- \"$@\"' --",
      "bash -c 'cd plugins/semantic-search && uv run ruff check -- \"$@\"' --"
    ]
  },
  "keywords": [
    "claude",
    "claude-code",
    "skills",
    "ai",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cajias/claude-skills.git"
  }
}
