    {
      "id": "transition-overuse",
      "name": "Overused Conjunctive/Transitional Phrases",
      "priority": "medium",
      "description": "Not always wrong, but flag when multiple appear in same text",
      "detection_type": "frequency",
      "threshold": "per_500_words",
      "patterns": [
        {
          "pattern": "moreover",
          "type": "word",
          "threshold": 1,
          "note": "Flag if >1 occurrence per 500 words"
        },
        {
          "pattern": "furthermore",
          "type": "word",
          "threshold": 1,
          "note": "Flag if >1 occurrence per 500 words"
        },
        {
          "pattern": "additionally",
          "type": "word",
          "threshold": 1,
          "note": "Flag if >1 occurrence per 500 words"
        },
        {
          "pattern": "in addition",
          "type": "phrase",
          "threshold": 1,
          "note": "Flag if >1 occurrence per 500 words"
        },
        {
          "pattern": "on the other hand",
          "type": "phrase",
          "threshold": 1,
          "note": "Flag if >1 occurrence per 500 words"
        },
        {
          "pattern": "however",
          "type": "word",
          "threshold": 2,
          "note": "Flag if >2 occurrences per 500 words"
        },
        {
          "pattern": "in contrast",
          "type": "phrase",
          "threshold": 1,
          "note": "Flag if >1 occurrence per 500 words"
        },
        {
          "pattern": "nevertheless",
          "type": "word",
          "threshold": 1,
          "note": "Flag if >1 occurrence per 500 words"
        },
        {
          "pattern": "consequently",
          "type": "word",
          "threshold": 1,
          "note": "Flag if >1 occurrence per 500 words"
        }
      ],
      "replacement_strategy": "Vary sentence structure, use simpler connectors (but, and, also), or restructure to eliminate need for transition"
    },
    {
      "id": "negative-parallelism",
      "name": "Negative Parallelism Pattern",
      "priority": "high",
      "description": "Pattern: 'It's not X, it's Y' or 'not just X, but Y' - creates false drama",
      "patterns": [
        {
          "pattern": "(not just|not only|not merely|it'?s not|isn'?t just|more than just).{1,50}(but|but also|it'?s|rather)",
          "type": "phrase",
          "regex": true,
          "replacements": [],
          "action": "rephrase",
          "note": "Rephrase to direct statement"
        }
      ]
    },
