    {
      "id": "em-dash-overuse",
      "name": "Em Dash Overuse",
      "priority": "medium",
      "description": "AI uses em dashes more frequently than human writers",
      "detection_type": "frequency",
      "threshold": "per_500_words",
      "patterns": [
        {
          "pattern": "—",
          "type": "punctuation",
          "threshold": 2,
          "note": "Flag if >2 em dashes per 500 words",
          "replacements": ["commas", "parentheses", "restructure sentence"]
        }
      ]
    },
    {
      "id": "rule-of-three",
      "name": "Rule of Three Overuse",
      "priority": "medium",
      "description": "AI overuses three-part lists",
      "detection_type": "pattern_frequency",
      "patterns": [
        {
          "pattern": "\\b(\\w+),\\s+(\\w+),?\\s+and\\s+(\\w+)\\b",
          "type": "list",
          "regex": true,
          "note": "Flag when appearing multiple times",
          "replacement_strategy": "Vary list lengths (sometimes 2, sometimes 4), or restructure entirely"
        }
      ]
    },
    {
      "id": "formatting-patterns",
      "name": "Formatting Patterns",
      "priority": "low",
      "description": "Common AI formatting quirks",
      "patterns": [
        {
          "pattern": "title_case_headers",
          "type": "formatting",
          "detection": "Every main word capitalized in headers",
          "action": "Use sentence case"
        },
        {
          "pattern": "excessive_bold",
          "type": "formatting",
          "detection": ">3 bold phrases per section",
          "action": "Reduce bolding"
        },
        {
          "pattern": "uniform_bullets",
          "type": "formatting",
          "detection": "Every item follows **Topic:** description",
          "action": "Vary formatting"
        },
        {
          "pattern": "\\*[^*]+\\*",
          "type": "markdown",
          "regex": true,
          "note": "Single asterisks for emphasis",
          "action": "Use proper formatting"
        },
        {
          "pattern": "_[^_]+_",
          "type": "markdown",
          "regex": true,
          "note": "Underscores for emphasis",
          "action": "Use proper formatting"
        }
      ]
    },
