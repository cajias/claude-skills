{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Writing Humanizer Configuration Schema",
  "description": "Configuration options for the AI Writing Humanizer skill",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["interactive", "batch", "report-only"],
      "description": "Processing mode: interactive (review each change), batch (auto-apply), or report-only (analyze without changes)",
      "default": "interactive"
    },
    "max_iterations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Maximum number of analysis-refinement iterations before stopping",
      "default": 5
    },
    "auto_fix_priority": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["critical", "high", "medium", "low"]
      },
      "description": "Priority levels to auto-fix in batch mode",
      "default": ["critical", "high"]
    },
    "require_approval_for": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["critical", "high", "medium", "low"]
      },
      "description": "Priority levels requiring manual approval",
      "default": ["medium", "low"]
    },
    "strict_mode": {
      "type": "boolean",
      "description": "Enable stricter pattern detection with lower thresholds",
      "default": false
    },
    "preserve_technical_terms": {
      "type": "boolean",
      "description": "Avoid flagging legitimate technical terminology",
      "default": true
    },
    "output_format": {
      "type": "string",
      "enum": ["markdown", "json", "diff"],
      "description": "Output format for results",
      "default": "markdown"
    },
    "categories_to_check": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "all",
          "inflated-symbolism",
          "promotional-language",
          "editorializing",
          "transition-overuse",
          "negative-parallelism",
          "participle-endings",
          "weasel-wording",
          "em-dash-overuse",
          "rule-of-three",
          "formatting-patterns",
          "buzzwords",
          "filler-phrases",
          "chatbot-artifacts",
          "section-conclusions",
          "hedge-words"
        ]
      },
      "description": "Pattern categories to check (use 'all' for all categories)",
      "default": ["all"]
    },
    "categories_to_skip": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "inflated-symbolism",
          "promotional-language",
          "editorializing",
          "transition-overuse",
          "negative-parallelism",
          "participle-endings",
          "weasel-wording",
          "em-dash-overuse",
          "rule-of-three",
          "formatting-patterns",
          "buzzwords",
          "filler-phrases",
          "chatbot-artifacts",
          "section-conclusions",
          "hedge-words"
        ]
      },
      "description": "Pattern categories to skip during analysis",
      "default": []
    },
    "strict_thresholds": {
      "type": "object",
      "description": "Custom thresholds when strict_mode is enabled",
      "properties": {
        "em_dash": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum em dashes per 500 words in strict mode",
          "default": 1
        },
        "transitions": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum transition words per 500 words in strict mode",
          "default": 1
        },
        "hedge_words": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum hedge words per 200 words in strict mode",
          "default": 2
        }
      }
    }
  },
  "additionalProperties": false
}
